# Server configuration (OPS-03). Every variable the server reads is listed here.
# Any secret below can instead be read from a file: set <NAME>_FILE=/path/to/file
# (for Docker or Kubernetes secrets). Setting both <NAME> and <NAME>_FILE is an error.

# development | production (default: production)
PM_ENV=development

# Address the API listens on (default: :8080)
PM_HTTP_ADDR=:8080

# Address for Prometheus metrics; keep it off the public network. Empty disables it. (default: :9090)
PM_METRICS_ADDR=:9090

# PostgreSQL connection URL (required, secret)
PM_DATABASE_URL=postgres://pm:pm-dev-only@localhost:5433/pm?sslmode=disable

# debug | info | warn | error (default: info)
PM_LOG_LEVEL=info

# json (default, for log collectors) | text (easier to read in a terminal)
PM_LOG_FORMAT=json

# Comma-separated proxy IPs or CIDRs whose X-Forwarded-For header is trusted (default: none)
PM_TRUSTED_PROXIES=

# Outgoing email for invites and alerts.
# SMTP server host (required)
PM_SMTP_HOST=localhost
# SMTP port (default: 587)
PM_SMTP_PORT=1025
# Username and password; set a username to enable SMTP authentication (password is a secret)
PM_SMTP_USERNAME=
PM_SMTP_PASSWORD=
# Sender address (required)
PM_SMTP_FROM=Password Manager <vault@example.com>
# starttls (default) | tls | none (none is only allowed when PM_ENV=development)
PM_SMTP_TLS=none
