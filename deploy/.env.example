# Server configuration (OPS-03). Copy to .env and adjust.

# development | production (default: production)
PM_ENV=development

# Address the HTTP server listens on (default: :8080)
PM_HTTP_ADDR=:8080

# PostgreSQL connection URL (required)
PM_DATABASE_URL=postgres://pm:pm-dev-only@localhost:5433/pm?sslmode=disable

# debug | info | warn | error (default: info)
PM_LOG_LEVEL=info

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (default: none)
PM_TRUSTED_PROXIES=
